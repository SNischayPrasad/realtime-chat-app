{
  "name": "Transmission real-time chat",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },

  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Chat app",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },

  "remoteEnv": {
    "DATABASE_URL": "postgres://chat:chat@localhost:5432/chat?sslmode=disable",
    "AUTH_SECRET": "codespace-development-secret-not-for-production"
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
