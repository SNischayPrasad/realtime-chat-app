{
  "name": "Transmission real-time chat",

  // No "image", no "features", no compose: the stock Codespaces image is the
  // only configuration that reliably gets GitHub's own bootstrap, which is what
  // makes `gh codespace ssh` and `gh codespace logs` work. Every customisation
  // tried here cost that, and with it any way to diagnose a failed boot.

  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Chat app",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
