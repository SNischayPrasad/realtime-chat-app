# Postgres connection string. On Vercel this is injected automatically by the
# Neon / Vercel Postgres marketplace integration (DATABASE_URL or POSTGRES_URL).
# Leave it unset locally to run against the in-memory dev store.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# HMAC key used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional tuning for the Server-Sent Events transport (milliseconds).
CHAT_STREAM_POLL_MS=700
CHAT_STREAM_TTL_MS=50000

# Optional TURN relay for calls on strict networks (symmetric NAT, corporate
# firewalls). Comma-separated URLs, plus EITHER a coturn use-auth-secret
# shared secret OR static credentials from a hosted provider.
CHAT_TURN_URLS=
CHAT_TURN_SECRET=
# CHAT_TURN_USERNAME=
# CHAT_TURN_CREDENTIAL=

# Accounts created before end-to-end encryption can upgrade on sign-in until
# this date (ISO 8601). Default 2026-11-15.
# CHAT_LEGACY_AUTH_UNTIL=2026-11-15T00:00:00Z
