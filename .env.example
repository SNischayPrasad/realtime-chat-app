# Postgres connection string. On Vercel this is injected automatically by the
# Neon / Vercel Postgres marketplace integration (DATABASE_URL or POSTGRES_URL).
# Leave it unset locally to run against the in-memory dev store.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# HMAC key used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional tuning for the Server-Sent Events transport (milliseconds).
CHAT_STREAM_POLL_MS=700
CHAT_STREAM_TTL_MS=50000
